<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>TimeSeries.Migration</RootNamespace>
    <AssemblyName>TimeSeries.Migration</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>TimeSeriesMigration</PackageId>
    <Description>Reusable time-series migration runner library extracted from TimeSeriesMigration CLI. Contains TimeSeriesRunner, extraction/simulation/normalization services, Settl clients, and profile loader for hosting in-process from a dashboard or other API host.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TimeSeries.Cli" />
    <InternalsVisibleTo Include="TimeSeries.Cli.Tests" />
    <InternalsVisibleTo Include="Dashboard.Api" />
    <InternalsVisibleTo Include="Dashboard.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TimeSeries.Core\TimeSeries.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\SettlClient\src\DataMigration.SettlApi\DataMigration.SettlApi.csproj" />
    <ProjectReference Include="..\..\..\XellentDomain\src\DataMigration.Domain.TimeSeries\DataMigration.Domain.TimeSeries.csproj" />
    <ProjectReference Include="..\..\..\XellentDomain\src\DataMigration.XellentData\DataMigration.XellentData.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
  </ItemGroup>

</Project>
