<Project>
  <!--
    Repo-wide .NET build defaults. Applied automatically to every .csproj
    under this directory tree by MSBuild.

    Linting policy: analyzers enabled at the .NET SDK default analysis mode,
    warnings are errors. Default mode is the baseline that ships with .NET 9
    and avoids the noisy perf rules added in Recommended (CA1848, CA1873).
  -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Base version. Pakke-version = VersionPrefix-VersionSuffix.
         Default VersionSuffix=dev så lokal pack giver 0.1.0-dev (prerelease).
         CI overrider med /p:VersionSuffix=preview.{BuildId} → 0.1.0-preview.{BuildId}.
         Stable release (0.1.0) kræver explicit /p:VersionSuffix= (tom). -->
    <VersionPrefix>0.1.31</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <Authors>Verdo</Authors>
    <Company>Verdo</Company>
    <RepositoryUrl>https://dev.azure.com/verdo365/Verdo%20Agile%20Development/_git/NewSettlement.DataMigration</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
